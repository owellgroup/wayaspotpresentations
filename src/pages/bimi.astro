---
const title = 'Wayaspot BIMI Logo';
const imageSrc = '/bimi-svg-tiny-12-ps.svg';
const imageAlt = 'Wayaspot BIMI logo';
const imageHref = 'https://wayaspot.com';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#00CC99" />
    <title>{title}</title>
    <link rel="icon" href={imageSrc} type="image/svg+xml" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        min-height: 100%;
        min-height: 100dvh;
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: #f4f4f4;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: #111;
      }

      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        width: min(100%, 420px);
        text-align: center;
      }

      .bimi-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: min(280px, 72vw);
        aspect-ratio: 1;
        padding: 20px;
        background: #fff;
        border: 1px solid #d4d4d4;
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .bimi-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
      }

      .bimi-link:focus-visible {
        outline: 3px solid #00cc99;
        outline-offset: 4px;
      }

      .bimi-link img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .meta {
        font-size: 14px;
        line-height: 1.6;
        color: #444;
      }

      .meta a {
        color: #009977;
        word-break: break-all;
      }
    </style>
  </head>
  <body>
    <main>
      <a class="bimi-link" href={imageHref} target="_blank" rel="noopener noreferrer">
        <img src={imageSrc} alt={imageAlt} width="200" height="200" />
      </a>

      <p class="meta">
        BIMI logo · Click image to visit
        <a href={imageHref}>{imageHref}</a>
        <br />
        Direct file:
        <a href={imageSrc}>{Astro.site ? new URL(imageSrc, Astro.site).href : imageSrc}</a>
      </p>
    </main>
  </body>
</html>
